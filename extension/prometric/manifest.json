{
  "manifest_version": 3,
  "name": "Prometric Auto Register — TrainFlow",
  "version": "4.1.3",
  "description": "Prometric registration linked to your TrainFlow trainee sheet",
  "permissions": [
    "tabs",
    "storage",
    "downloads",
    "contextMenus",
    "unlimitedStorage",
    "notifications"
  ],
  "host_permissions": [
    "https://tcnet1.prometric.com/*",
    "https://docs.google.com/*",
    "https://trainf.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tcnet1.prometric.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tcnet1.prometric.com/*"
      ],
      "js": [
        "dom-utils.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://trainf.vercel.app/*"
      ],
      "js": [
        "trainflow-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
