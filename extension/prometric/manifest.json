{
  "manifest_version": 3,
  "name": "TrainFlow — Prometric",
  "version": "4.3.0",
  "description": "Prometric registration and selected exam results linked to your TrainFlow trainee sheet",
  "permissions": [
    "tabs",
    "storage",
    "downloads",
    "contextMenus",
    "unlimitedStorage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://tcnet1.prometric.com/*",
    "https://trainf.vercel.app/*"
  ],
  "optional_host_permissions": ["https://docs.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "trainflow-icon16.png",
      "48": "trainflow-icon48.png",
      "128": "trainflow-icon128.png"
    }
  },
  "icons": {
    "16": "trainflow-icon16.png",
    "48": "trainflow-icon48.png",
    "128": "trainflow-icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://tcnet1.prometric.com/*"],
      "js": ["exam-results-core.js", "exam-results-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tcnet1.prometric.com/*"
      ],
      "js": [
        "prom-channel.js",
        "bridge.js",
        "dom-utils.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://trainf.vercel.app/*"
      ],
      "js": [
        "trainflow-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
