{
  "manifest_version": 3,
  "name": "TrainFlow — WhatsApp daily inventory",
  "version": "1.0.4",
  "description": "Send your TrainFlow inventory report through your logged-in WhatsApp Web at your chosen Saudi time.",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://trainf.vercel.app/*",
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TrainFlow WhatsApp"
  },
  "content_scripts": [
    {
      "matches": [
        "https://trainf.vercel.app/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "sender.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
